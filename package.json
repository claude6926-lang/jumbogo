{
  "name": "jumbo-go",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sandbox": "node scripts/test-sandbox.mjs",
    "dev": "node scripts/demo-server.mjs --dev",
    "dev:https": "node scripts/demo-server.mjs --dev",
    "demo": "npm run build && npm run demo:start",
    "demo:start": "node scripts/demo-server.mjs",
    "build": "node scripts/build.mjs",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "qa": "node scripts/qa-run.mjs",
    "qa:production": "node scripts/qa-run.mjs --production-only",
    "admin:create": "tsx scripts/create-admin.ts",
    "db:migrate": "tsx scripts/migrate-database.ts"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.0",
    "@fontsource/kanit": "^5.2.0",
    "@libsql/client": "^0.18.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "next": "^15.5.12",
    "openid-client": "^6.8.8",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.4",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/google.maps": "^3.66.4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "postcss": "^8.5.23"
  },
  "type": "module",
  "engines": {
    "node": "24.x"
  }
}
